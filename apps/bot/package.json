{
  "name": "@cobra/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:llm": "RUN_LLM_TESTS=1 vitest run test/parser.llm.test.ts",
    "webhook:set": "tsx --env-file-if-exists=../../.env scripts/webhook.ts set",
    "webhook:info": "tsx --env-file-if-exists=../../.env scripts/webhook.ts info",
    "webhook:delete": "tsx --env-file-if-exists=../../.env scripts/webhook.ts delete"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@cobra/core": "workspace:*",
    "@cobra/db": "workspace:*",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
