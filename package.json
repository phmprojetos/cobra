{
  "name": "cobra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cobra/web --filter @cobra/bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:llm": "pnpm --filter @cobra/bot test:llm",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:seed": "supabase db push --include-seed",
    "test:db": "RUN_DB_TESTS=1 pnpm -r --if-present test",
    "demo": "DEMO=1 pnpm --filter @cobra/web exec next dev --port 3100"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3"
  }
}
