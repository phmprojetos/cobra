# Copie para .env (raiz do monorepo). Nunca commite o .env.

# ── Supabase (projeto na plataforma: Project Settings → API) ──
# URL da API (não é a string do Postgres)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Postgres via pooler de sessão (Connect → Session pooler), usado por db:push e db:types
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_ANON_KEY=
# Somente servidor (bot e jobs). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Painel web (Next.js) — mesmos valores, expostos ao navegador
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública do painel (para o link do magic link). Em dev: http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Painel local sem login (dev apenas; recusado em produção). Lê com a service role no servidor.
PAINEL_SEM_LOGIN=false

# ── Testes de integração (pnpm test:db): projeto Supabase SEPARADO, nunca o de produção ──
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# ≥ 16 caracteres aleatórios (ex.: openssl rand -hex 32). Obrigatório no modo webhook.
TELEGRAM_WEBHOOK_SECRET=
# Seu user id do Telegram (fale com @userinfobot). Vários: separados por vírgula.
TELEGRAM_ALLOWED_USER_IDS=
# Usado só por `pnpm --filter @cobra/bot webhook:set`
TELEGRAM_WEBHOOK_URL=https://bot.seudominio.com/telegram

# ── Bot ──
# polling (desenvolvimento) | webhook (produção)
BOT_MODO=polling
PORT=8090
# Agendador interno de notificações a cada 15 min
NOTIFICACOES_CRON=true
# Protege POST /jobs/notificacoes (se acionado por cron externo)
JOB_SECRET=

# ── Claude API ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Padrões globais (a tabela `configuracoes` tem precedência) ──
MOEDA=BRL
LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

# ── Deploy (docker-compose na VPS) ──
# Domínio do bot para o HTTPS automático do Caddy
BOT_DOMINIO=bot.seudominio.com
